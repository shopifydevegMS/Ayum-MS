      "type": "text",
      "id": "pd_mb",
      "label": "Padding (Mobile)",
      "placeholder": ",,50px,",
      "visible_if": "{{ section.settings.pd != blank }}"
    },
  ],
  "blocks": [
    {
      "type": "_heading_liquid"
    },
    {
      "type": "_heading_search"
    },
    {
      "type": "_heading_brc"
    }
  ],
