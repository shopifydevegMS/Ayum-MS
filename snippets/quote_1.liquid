<div class="hdt-quote-wrap quote_01">
  {%- if block.settings.image_avata -%}
    {%- assign image = block.settings.image_avata -%} 
      {{ image | image_url: width: image.width | image_tag: loading: 'lazy', width: image.width, height: image.height, widths: '200,400,600,800,1000', class: 'hdt-quote-avatar' }}
    {%- endif -%}
  <div class="hdt-quote-content">
     {%- render 'rating_star', rating: block.settings.rating -%}
     {%- if section.settings.ter_des == '9' -%}
       {%- if block.settings.rating >= 1 -%}<span class="sr-only">{{ 'accessibility.star_reviews_info' | t: rating_value: block.settings.rating, rating_max: 5 }}</span>{%- endif -%}
       {%- if block.settings.badge != blank -%}<span class="cca-review-badge">{{ block.settings.badge | escape }}</span>{%- endif -%}
     {%- endif -%}
     {% if block.settings.heading != blank %}
     <h3 class="hdt-testimonial-heading">{{ block.settings.heading }}</h3>
     {% endif %}
    {{ block.settings.content }}
    <div class="hdt-quote-author">{{ block.settings.title }}</div>
    {%- if block.settings.pos != blank -%}<div class="hdt-quote-position">{{ block.settings.pos }}</div>{%- endif -%} 
  </div>
</div>