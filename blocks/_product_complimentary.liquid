{%- liquid
  assign target = product
  assign product = section.settings.product | default: target
  # AYUM: the add button is opt-in through the cca label; with the label blank the block renders as in Kalles
  assign cca_show_btn = false
  if block.settings.show_ultra_btn and block.settings.cca_add_label != blank
    assign cca_show_btn = true
  endif
-%}
<style>
  .hdt-product__complimentary:has(.hdt-product__complimentary-list:empty){
    display: none;
  }
</style>
{%- unless product == blank and product.metafields.shopify--discovery--product_recommendation.complementary_products.value == blank -%}
  <div class="hdt-product-info__item hdt-product__price hdt-product__complimentary" {{ block.shopify_attributes }}>
    <div class="hdt-product-info__item hdt-product__complimentary">
      <div class="hdt-product__complimentary-wrap">
        <h3 class="hdt-text-lg hdt-font-semibold">{{ block.settings.text }}</h3>
        <ul class="hdt-product__complimentary-list hdt-ratio--adapt_image">
        {%- for product in product.metafields.shopify--discovery--product_recommendation.complementary_products.value -%}
          <li class="hdt-product__complimentary-item">
            {%- render 'pr_loop_item', section_id: block.id, product: product, sizes: "84px", widths: "84, 100, 180, 200", show_btn: cca_show_btn, add_label: block.settings.cca_add_label -%}
          </li>
        {%- endfor -%}
        </ul>
      </div>
    </div>
  </div>
{%- endunless -%}
{% schema %}
{
  "name": "t:sections.main-product.blocks.complimentary_products.name",
  "tag": null,
  "settings":[
    {
      "type": "inline_richtext",
      "id": "text",
      "label": "t:sections.main-product.blocks.complimentary_products.settings.text.label",
      "default": "Pairs well with"
    },
    {
      "type": "checkbox",
      "id": "show_ultra_btn",
      "label": "Show button add to cart",
      "default": false
    },
    {
      "type": "text",
      "id": "cca_add_label",
      "label": "Button label (cca)",
      "info": "Shows a text add-to-cart button on each product. Leave blank for the theme default.",
      "visible_if": "{{ block.settings.show_ultra_btn }}"
    }
  ],
  "presets": [
    {
      "name": "t:sections.main-product.blocks.complimentary_products.name"
    }
  ]
}
{% endschema %}